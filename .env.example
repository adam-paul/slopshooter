# Copy to .env for local pipeline runs (bun loads .env automatically).
# In CI these come from GitHub Actions secrets — see .github/workflows/poll.yml.

# twitterapi.io key (https://twitterapi.io — pay-as-you-go, ~$0.15/1k tweets)
TWITTERAPI_IO_KEY=

# Cloudflare account id (dashboard sidebar) and the D1 database id printed by
# `wrangler d1 create pangram-leaderboard`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# API token with the "D1 Edit" permission (My Profile -> API Tokens)
CLOUDFLARE_API_TOKEN=
