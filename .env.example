# Copy to .env for local pipeline runs (bun loads .env automatically).
# In CI these come from GitHub Actions secrets — see .github/workflows/poll.yml.

# twitterapi.io key (https://twitterapi.io — pay-as-you-go, ~$0.15/1k tweets)
TWITTERAPI_IO_KEY=

# Cloudflare account id (dashboard sidebar) and the D1 database id printed by
# `wrangler d1 create slopshooter`
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# API token with the "D1 Edit" permission (My Profile -> API Tokens).
# Deliberately NOT named CLOUDFLARE_API_TOKEN: bun auto-loads .env into every
# bun/bunx process, and wrangler would adopt that variable over your OAuth
# login, breaking login/whoami/deploy from inside this directory.
# (The GitHub secret is still called CLOUDFLARE_API_TOKEN; the workflow maps it.)
D1_API_TOKEN=
