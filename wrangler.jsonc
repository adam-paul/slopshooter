{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "slopshooter",
	// Personal account (notadampaul — same as partition-prize), NOT playcademy.
	"account_id": "a8e9faf9352aba8ba3f98c5b12196af4",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "slopshooter",
			"database_id": "435bb16e-5d30-467a-9db2-4993d68ed325",
			"migrations_dir": "migrations"
		}
	]
}
